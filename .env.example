# 复制为 .env 并填写后发布功能才会生效；两个渠道互相独立，可只配其一。

# GitHub 发布（git push 方式）
# 仓库地址，如 myname/iptv-live
GH_REPO=
# 需要该仓库的写权限（内容读写 repo scope）
GH_TOKEN=
# 分支，默认 main
GH_BRANCH=main

# Cloudflare R2 发布（S3 兼容 API）
R2_BUCKET=
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
